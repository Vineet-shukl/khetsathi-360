# ==============================================================================
# KhetSathi 360 — Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Agronomic Machine Learning Engine Settings
# Set to "true" to activate Tier-2 LightGBM bounded residual adjustments on top of ICAR base
ENABLE_ML_RESIDUAL=true

# Google Gemini Vision API Key (Optional)
# Required for real-time multimodal photo extraction of physical Soil Health Cards.
# If omitted or offline, the system safely uses verified DAC&FW regional benchmark extractors.
GEMINI_API_KEY=your_gemini_api_key_here

# Python Runtime Environment
PYTHON_VERSION=3.11.9
